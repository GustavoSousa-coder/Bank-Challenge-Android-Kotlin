<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do item de navegacao: selecionado = branco, normal = preto -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_black" />
        </shape>
    </item>
</selector>
