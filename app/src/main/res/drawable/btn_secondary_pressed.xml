<?xml version="1.0" encoding="utf-8"?>
<!-- Estado pressionado do botao secundario: face deslocada (efeito "afundar") -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/pixel_shadow_offset_sm"
        android:top="@dimen/pixel_shadow_offset_sm">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_black" />
            <stroke
                android:width="@dimen/pixel_border"
                android:color="@color/pixel_white" />
        </shape>
    </item>
</layer-list>
