<?xml version="1.0" encoding="utf-8"?>
<!-- Card com sombra pixel dura (deslocamento 4dp, sem blur) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra branca deslocada para baixo/direita -->
    <item
        android:left="@dimen/pixel_shadow_offset"
        android:top="@dimen/pixel_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_white" />
        </shape>
    </item>
    <!-- Face do card -->
    <item
        android:right="@dimen/pixel_shadow_offset"
        android:bottom="@dimen/pixel_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_card" />
            <stroke
                android:width="@dimen/pixel_border"
                android:color="@color/pixel_white" />
        </shape>
    </item>
</layer-list>
