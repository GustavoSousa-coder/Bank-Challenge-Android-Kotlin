<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pixel_card"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pixel_white"
    app:strokeWidth="@dimen/pixel_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:id="@+id/transaction_icon_box"
            android:layout_width="@dimen/icon_box_size"
            android:layout_height="@dimen/icon_box_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/transaction_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/pixel_white"
                tools:src="@drawable/ic_shoping_bag" />
        </FrameLayout>

        <TextView
            android:id="@+id/transaction_name"
            style="@style/PixelText.Sm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:textSize="17sp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount"
            app:layout_constraintTop_toTopOf="@id/transaction_icon_box"
            tools:text="SUPERMERCADO BOM PRECO" />

        <TextView
            android:id="@+id/transaction_type"
            style="@style/BodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:textSize="16sp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount"
            app:layout_constraintTop_toBottomOf="@id/transaction_name"
            tools:text="Compra no debito" />

        <TextView
            android:id="@+id/transaction_date"
            style="@style/PixelText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount"
            app:layout_constraintTop_toBottomOf="@id/transaction_type"
            app:layout_constraintBottom_toBottomOf="@id/transaction_icon_box"
            tools:text="01 AGO • 14:32" />

        <TextView
            android:id="@+id/transaction_amount"
            style="@style/PixelText.Sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="- R$ 152,40"
            tools:textColor="@color/pixel_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
