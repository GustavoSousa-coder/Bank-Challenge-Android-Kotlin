<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTipoChaveItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPF"
                android:textSize="13sp"
                android:textColor="@color/gray_secondary"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtValorChaveItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="000.000.000-00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black_pure"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCopiarChaveItem"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_copy_button"
            android:text="@string/copiar"
            android:textColor="@color/black_pure"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnRemoverChaveItem"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@android:color/transparent"
            android:text="@string/remover"
            android:textColor="@color/gray_secondary"
            android:textSize="12sp"
            android:textAllCaps="false" />

    </LinearLayout>

</androidx.cardview.widget.CardView>