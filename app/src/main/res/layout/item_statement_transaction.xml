<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pixel_card"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pixel_white"
    app:strokeWidth="@dimen/pixel_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:id="@+id/transaction_icon_box"
            android:layout_width="@dimen/icon_box_size"
            android:layout_height="@dimen/icon_box_size"
            android:background="@drawable/bg_icon_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/transaction_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/pixel_white"
                tools:src="@drawable/ic_arrow_down_left" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/transaction_amount_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/transaction_direction_icon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:importantForAccessibility="no"
                    app:tint="@color/pixel_muted"
                    tools:src="@drawable/ic_arrow_down_left" />

                <TextView
                    android:id="@+id/transaction_direction_label"
                    style="@style/PixelText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="ENTRADA" />
            </LinearLayout>

            <TextView
                android:id="@+id/transaction_amount"
                style="@style/PixelText.Sm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="+ R$ 250,00"
                tools:textColor="@color/pixel_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/transaction_name"
            style="@style/PixelText.Sm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount_column"
            app:layout_constraintTop_toTopOf="@id/transaction_icon_box"
            tools:text="PIX RECEBIDO — LUCAS" />

        <TextView
            android:id="@+id/transaction_type"
            style="@style/BodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount_column"
            app:layout_constraintTop_toBottomOf="@id/transaction_name"
            tools:text="Pix recebido" />

        <LinearLayout
            android:id="@+id/transaction_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@id/transaction_icon_box"
            app:layout_constraintEnd_toStartOf="@id/transaction_amount_column"
            app:layout_constraintTop_toBottomOf="@id/transaction_type"
            app:layout_constraintBottom_toBottomOf="@id/transaction_icon_box">

            <TextView
                android:id="@+id/transaction_date"
                style="@style/PixelText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="01 AGO • 14:32" />

            <TextView
                android:id="@+id/transaction_status"
                style="@style/PixelText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_box"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="2dp"
                tools:text="CONCLUÍDO" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
