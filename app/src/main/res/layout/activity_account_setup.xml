<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/title_account_setup"
        android:textAlignment="center"
        android:textSize="45sp"
        android:textColor="@color/pixel_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:text="@string/description_account_setup"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textColor="@color/pixel_black"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_button_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <Button
        android:id="@+id/btnConfirmar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/confirmar"
        android:textSize="20sp"
        android:textColor="@color/pixel_white"
        android:background="@drawable/bg_rounded_borders"
        app:backgroundTint="@color/pixel_black"
        app:cornerRadius="5dp"
        app:shapeAppearanceOverlay="@style/RoundedCorners"
        app:layout_constraintTop_toTopOf="@id/guideline_button_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>