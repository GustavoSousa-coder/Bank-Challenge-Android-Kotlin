<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_pure">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/register_title"
        android:textAlignment="center"
        android:textSize="45sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:text="@string/description_sub_title_register"
        android:textAlignment="center"
        android:textSize="25sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_button_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFields"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/guideline_button_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_edittext_8bit"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:hint="@string/nome"
                android:inputType="textPersonName"
                android:layerType="software"
                android:padding="20dp"
                android:textColor="@color/cardview_dark_background"
                android:textColorHint="@color/cardview_light_background"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/editCpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edittext_8bit"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:hint="@string/cpf"
                android:inputType="number"
                android:maxLength="14"
                android:layerType="software"
                android:padding="20dp"
                android:textColor="@color/cardview_dark_background"
                android:textColorHint="@color/cardview_light_background"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/editDataNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edittext_8bit"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:hint="@string/data_nascimento"
                android:inputType="number"
                android:layerType="software"
                android:padding="20dp"
                android:textColor="@color/cardview_dark_background"
                android:textColorHint="@color/cardview_light_background"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/editEmailRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edittext_8bit"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:layerType="software"
                android:padding="20dp"
                android:textColor="@color/cardview_dark_background"
                android:textColorHint="@color/cardview_light_background"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/editSenhaRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edittext_8bit"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:hint="@string/senha"
                android:inputType="textPassword"
                android:layerType="software"
                android:padding="20dp"
                android:textColor="@color/cardview_dark_background"
                android:textColorHint="@color/cardview_light_background"
                android:textSize="20sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnCadastrar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/cadastrar"
        android:textSize="20sp"
        android:background="@drawable/selector_btn_primary"
        app:backgroundTint="@color/white"
        app:cornerRadius="5dp"
        app:shapeAppearanceOverlay="@style/RoundedCorners"
        app:layout_constraintTop_toTopOf="@id/guideline_button_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>