<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_pure"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/register_title"
        android:textAlignment="center"
        android:textSize="45sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:text="@string/description_sub_title_register"
        android:textAlignment="center"
        android:textSize="25sp" />

        //nome
    <EditText
        android:id="@+id/editNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_edittext_8bit"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:hint="@string/nome"
        android:inputType="textPersonName"
        android:layerType="software"
        android:padding="20dp"
        android:textColor="@color/cardview_dark_background"
        android:textColorHint="@color/cardview_light_background"
        android:textSize="20sp" />

        //cpf
    <EditText
        android:id="@+id/editCpf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_edittext_8bit"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:hint="@string/cpf"
        android:inputType="number"
        android:maxLength="14"
        android:layerType="software"
        android:padding="20dp"
        android:textColor="@color/cardview_dark_background"
        android:textColorHint="@color/cardview_light_background"
        android:textSize="20sp" />

        //dataNacimento
    <EditText
        android:id="@+id/editDataNascimento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_edittext_8bit"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:hint="@string/data_nascimento"
        android:inputType="number"
        android:layerType="software"
        android:padding="20dp"
        android:textColor="@color/cardview_dark_background"
        android:textColorHint="@color/cardview_light_background"
        android:textSize="20sp" />

        //email
    <EditText
        android:id="@+id/editEmailRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_edittext_8bit"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        android:layerType="software"
        android:padding="20dp"
        android:textColor="@color/cardview_dark_background"
        android:textColorHint="@color/cardview_light_background"
        android:textSize="20sp" />

        //senha
    <EditText
        android:id="@+id/editSenhaRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edittext_8bit"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:hint="@string/senha"
        android:inputType="textPassword"
        android:layerType="software"
        android:padding="20dp"
        android:textColor="@color/cardview_dark_background"
        android:textColorHint="@color/cardview_light_background"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnCadastrar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_weight="0.3"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:gravity="center"
        android:text="@string/cadastrar"
        android:textSize="20sp"
        app:backgroundTint="@color/white"
        app:cornerRadius="5dp"
        app:shapeAppearanceOverlay="@style/RoundedCorners" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>