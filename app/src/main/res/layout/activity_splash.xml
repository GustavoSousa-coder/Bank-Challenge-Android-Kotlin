<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/barsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View android:id="@+id/bar1" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginBottom="3dp" android:background="@color/black_soft" />
        <View android:id="@+id/bar2" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginBottom="3dp" android:background="@color/gray_disabled" />
        <View android:id="@+id/bar3" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginBottom="3dp" android:background="@color/gray_secondary" />
        <View android:id="@+id/bar4" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginBottom="3dp" android:background="@color/silver_pearl" />
        <View android:id="@+id/bar5" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginBottom="3dp" android:background="@color/silver_light" />
        <View android:id="@+id/bar6" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:background="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Your Money"
        android:textColor="@color/black_pure"
        android:textSize="30sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:alpha="0" />

    <!-- Brilho que desliza sobre o texto, efeito "vidro" -->
    <View
        android:id="@+id/shimmerView"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/shimmer_gradient"
        android:alpha="0" />

</FrameLayout>