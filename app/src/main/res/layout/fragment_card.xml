<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginStart="@dimen/space_lg"
        android:text="Meus cartões"
        android:textColor="@color/black_pure"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_cards"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="@dimen/space_lg"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingHorizontal="@dimen/space_lg"
        app:layout_constraintTop_toBottomOf="@id/text_title" />

    <LinearLayout
        android:id="@+id/indicator_dots"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/pager_cards"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        app:layout_constraintTop_toBottomOf="@id/indicator_dots">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_block"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="Bloquear"
            android:fontFamily="@font/bitcountpropsingle_cursive_regular"
            android:textColor="@color/black_pure"
            app:strokeColor="@color/black_pure" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_card_settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Configurações"
            android:fontFamily="@font/bitcountpropsingle_cursive_regular"
            android:textColor="@color/black_pure"
            app:strokeColor="@color/black_pure" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_xl"
        android:backgroundTint="@color/black_pure"
        android:paddingVertical="@dimen/space_md"
        android:text="+ Adicionar novo cartão"
        android:textColor="@color/white"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/actions_row" />

</androidx.constraintlayout.widget.ConstraintLayout>