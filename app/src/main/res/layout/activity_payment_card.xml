<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirmar_cartao_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/confirmar_cartao_subtitulo"
            android:textSize="15sp"
            android:textColor="@color/gray_secondary" />

        <include layout="@layout/item_saldo_limite" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_virtual"
            android:elevation="4dp"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:text="@string/cartao_virtual"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_splash_mark"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/txtNumeroCartaoMascarado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="•••• •••• •••• ••••"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtNomeTitular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:text="@string/nome_titular_placeholder"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:letterSpacing="0.04" />

        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/valor_a_transferir"
                    android:textSize="14sp"
                    android:textColor="@color/gray_secondary" />

                <TextView
                    android:id="@+id/txtValorConfirmacaoCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 0,00"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_pure"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/digite_o_cvv"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <EditText
            android:id="@+id/editCvvAutorizacao"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:hint="@string/cvv_hint"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:gravity="center"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:textColorHint="@color/gray_secondary" />

        <Button
            android:id="@+id/btnAutorizarPagamentoCartao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/autorizar_pagamento"
            android:background="@drawable/bg_button_primary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>