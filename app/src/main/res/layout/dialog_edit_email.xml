<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="@dimen/profile_dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:background="@drawable/bg_card_shadow"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/PixelText.Md"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_edit_email_title" />

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_field_height"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_box"
            android:fontFamily="@font/bitcountpropsingle_cursive_regular"
            android:hint="@string/profile_edit_email_hint"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:textColor="@color/pixel_white"
            android:textColorHint="@color/pixel_muted"
            android:textSize="@dimen/text_body"
            tools:text="mariana.silva@example.com" />

        <TextView
            android:id="@+id/input_email_error"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/pixel_red"
            android:visibility="gone"
            tools:text="Informe um e-mail valido."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_email"
                style="@style/PixelButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/dialog_button_height"
                android:layout_weight="1"
                android:background="@drawable/selector_btn_secondary"
                android:paddingEnd="@dimen/pixel_shadow_offset_sm"
                android:paddingBottom="@dimen/pixel_shadow_offset_sm"
                android:text="@string/profile_edit_email_cancel"
                android:textColor="@color/pixel_white"
                android:textSize="@dimen/text_pixel_xs"
                tools:ignore="RtlSymmetry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_email"
                style="@style/PixelButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/dialog_button_height"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:background="@drawable/selector_btn_primary"
                android:paddingEnd="@dimen/pixel_shadow_offset_sm"
                android:paddingBottom="@dimen/pixel_shadow_offset_sm"
                android:text="@string/profile_edit_email_save"
                android:textColor="@color/pixel_black"
                android:textSize="@dimen/text_pixel_xs"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
