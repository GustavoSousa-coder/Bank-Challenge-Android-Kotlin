<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_root"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_square_action"
            android:elevation="2dp"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgAvatarUsuario"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_dark_outlined"
                android:contentDescription="@string/menu_perfil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtSaudacaoUsuario"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card_virtual"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Olá, ${}"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnNotificacao"
                app:layout_constraintStart_toEndOf="@id/imgAvatarUsuario"
                app:layout_constraintTop_toTopOf="@id/imgAvatarUsuario"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/btnNotificacao"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notification"
                android:padding="8dp"
                android:src="@drawable/ic_notificacao"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgAvatarUsuario" />

            <LinearLayout
                android:id="@+id/boxSaldo"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="96dp"
                android:background="@drawable/bg_card_virtual"
                android:orientation="vertical"
                android:padding="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgAvatarUsuario">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saldo_disponível"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textViewSaldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="R$ 0,00"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_toggle_selected"
                android:contentDescription="@string/menu_button"
                android:padding="12dp"
                android:src="@drawable/ic_menu_hamburguer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTransferir"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_square_action"
                android:elevation="4dp"
                android:text="@string/acao_transacao"
                android:textAllCaps="false"
                android:textColor="@color/black_pure"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMinhasChaves"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_square_action"
                android:elevation="4dp"
                android:text="@string/minhas_chaves_curto"
                android:textAllCaps="false"
                android:textColor="@color/black_pure"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPagarComPix"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_square_action"
                android:elevation="4dp"
                android:text="@string/pagar_com_pix"
                android:textAllCaps="false"
                android:textColor="@color/black_pure"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnMinhasEstatisticas"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_square_action"
            android:elevation="4dp"
            android:text="@string/minhas_estatisticas_titulo"
            android:textAllCaps="false"
            android:textColor="@color/black_pure"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMeusCartoes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_dark_outlined"
            android:elevation="4dp"
            android:text="@string/meus_cartoes_titulo"
            android:textAllCaps="false"
            android:textColor="@color/black_pure"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_secondary" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:fitsSystemWindows="true"
        app:itemIconTint="@color/black_pure"
        app:itemTextColor="@color/black_pure"
        app:itemIconPadding="16dp"
        app:itemHorizontalPadding="12dp"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetEnd="8dp"
        app:itemBackground="@drawable/bg_nav_item"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>