<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirmar_pix_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/confirmar_pix_subtitulo"
            android:textSize="15sp"
            android:textColor="@color/gray_secondary" />

        <include layout="@layout/item_saldo_limite" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/valor_a_transferir"
                    android:textSize="14sp"
                    android:textColor="@color/gray_secondary" />

                <TextView
                    android:id="@+id/txtValorConfirmacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="R$ 0,00"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_pure"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/tipo_chave_pix"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <RadioGroup
            android:id="@+id/radioGroupTipoChave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/chaveCpf"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:checked="true"
                android:background="@drawable/bg_chip_pix"
                android:textColor="@color/text_chip_pix"
                android:text="@string/chave_cpf"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <RadioButton
                android:id="@+id/chaveEmail"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_chip_pix"
                android:textColor="@color/text_chip_pix"
                android:text="@string/chave_email"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <RadioButton
                android:id="@+id/chaveTelefone"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_chip_pix"
                android:textColor="@color/text_chip_pix"
                android:text="@string/chave_telefone"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <RadioButton
                android:id="@+id/chaveAleatoria"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_chip_pix"
                android:textColor="@color/text_chip_pix"
                android:text="@string/chave_aleatoria"
                android:textSize="12sp"
                android:textAllCaps="false" />

        </RadioGroup>

        <EditText
            android:id="@+id/editChavePix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/digite_a_chave_pix"
            android:inputType="text"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="15sp"
            android:textColorHint="@color/gray_secondary" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gerar_qr_code"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/black_pure" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/gerar_qr_code_descricao"
                            android:textSize="13sp"
                            android:textColor="@color/gray_secondary" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchGerarQr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgQrCode"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="12dp"
                        android:contentDescription="@string/gerar_qr_code" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnConfirmarPix"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/confirmar"
            android:background="@drawable/bg_button_primary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>