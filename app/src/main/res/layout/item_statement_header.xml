<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pixel_black"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginEnd="@dimen/space_lg"
        android:text="@string/statement_title"
        android:textColor="@color/pixel_white"
        android:fontFamily="@font/bitcountpropsingle_cursive_regular"
        android:includeFontPadding="false"
        android:textSize="@dimen/text_pixel_md" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_lg"
        android:lineSpacingMultiplier="1.1"
        android:textSize="17sp"
        android:text="@string/statement_subtitle"
        style="@style/BodyText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_card_shadow"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_filter"
                app:tint="@color/pixel_white" />

            <TextView
                style="@style/PixelText.Sm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/statement_filter_title"
                android:textSize="19sp"
                android:textColor="@color/pixel_muted" />
        </LinearLayout>

        <TextView
            style="@style/PixelText.Xs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/statement_period_legend"
            android:textSize="16sp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:chipSpacingVertical="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_seconds"
                style="@style/PixelChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_seconds" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_days"
                style="@style/PixelChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_days" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_months"
                style="@style/PixelChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_months" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_years"
                style="@style/PixelChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_years" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_from_date"
                style="@style/PixelChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_from_date" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:id="@+id/filter_amount_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/PixelText.Xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/filter_amount_input"
                android:text="@string/statement_amount_legend"
                android:textSize="19sp"/>

            <EditText
                android:id="@+id/filter_amount_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_box"
                android:fontFamily="@font/bitcountpropsingle_cursive_regular"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:paddingHorizontal="@dimen/space_md"
                android:textColor="@color/pixel_white"
                android:textSize="@dimen/text_pixel_md"
                tools:text="7" />

            <TextView
                android:id="@+id/filter_amount_hint"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="@string/statement_hint_days" />

            <TextView
                android:id="@+id/filter_amount_error"
                style="@style/PixelText.Xs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/pixel_red"
                android:visibility="gone"
                android:textSize="15sp"
                tools:text="@string/statement_error_amount"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/filter_date_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                style="@style/PixelText.Xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/statement_date_legend" />

            <TextView
                android:id="@+id/filter_date_input"
                style="@style/PixelText.Md"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_box"
                android:clickable="true"
                android:contentDescription="@string/cd_statement_select_date"
                android:drawableEnd="@drawable/ic_calendar"
                android:drawablePadding="@dimen/space_sm"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:text="@string/statement_date_placeholder"
                android:textColor="@color/pixel_muted"
                app:drawableTint="@color/pixel_white"
                tools:ignore="UseCompatTextViewDrawableXml" />

            <TextView
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/statement_date_hint" />

            <TextView
                android:id="@+id/filter_date_error"
                style="@style/PixelText.Xs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/pixel_red"
                android:visibility="gone"
                tools:text="@string/statement_error_date_required"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/PixelButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/apply_button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/selector_btn_primary"
            android:paddingEnd="@dimen/pixel_shadow_offset"
            android:paddingBottom="@dimen/pixel_shadow_offset"
            android:text="@string/statement_apply"
            android:textColor="@color/pixel_black"
            android:textSize="@dimen/text_pixel_md"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_md"
            app:iconSize="@dimen/icon_size"
            app:iconTint="@color/pixel_black"
            tools:ignore="RtlSymmetry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFamily="@font/bitcountpropsingle_cursive_regular"
            android:text="@string/statement_clear"
            android:textColor="@color/pixel_muted"
            android:textSize="@dimen/text_pixel_xs"
            app:rippleColor="@color/pixel_surface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/summary_accent_width"
            android:layout_height="match_parent"
            android:background="@color/pixel_white"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/statement_applied_summary"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:textSize="17sp"
            tools:text="Últimos 7 dias" />
    </LinearLayout>

    <TextView
        android:id="@+id/statement_section_title"
        style="@style/PixelText.Sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/statement_recent_title"
        android:textSize="20sp"
        android:textColor="@color/pixel_muted" />

    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_box"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="@dimen/state_box_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/loading_blocks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/loading_block_size"
                android:layout_height="@dimen/loading_block_size"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@color/pixel_white" />

            <View
                android:layout_width="@dimen/loading_block_size"
                android:layout_height="@dimen/loading_block_size"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@color/pixel_white" />

            <View
                android:layout_width="@dimen/loading_block_size"
                android:layout_height="@dimen/loading_block_size"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@color/pixel_white" />

            <View
                android:layout_width="@dimen/loading_block_size"
                android:layout_height="@dimen/loading_block_size"
                android:background="@color/pixel_white" />
        </LinearLayout>

        <TextView
            style="@style/PixelText.Sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/statement_loading"
            android:textSize="15sp"
            android:textColor="@color/pixel_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_box"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/state_box_padding"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/state_icon_box_size"
            android:layout_height="@dimen/state_icon_box_size"
            android:background="@drawable/bg_icon_box_outline">

            <ImageView
                android:layout_width="@dimen/state_icon_size"
                android:layout_height="@dimen/state_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search_x"
                app:tint="@color/pixel_white" />
        </FrameLayout>

        <TextView
            style="@style/PixelText.Md"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/statement_empty_title" />

        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/statement_empty_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_change_filter"
            style="@style/PixelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/selector_btn_primary"
            android:minHeight="@dimen/field_height"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingEnd="@dimen/pixel_shadow_offset_sm"
            android:paddingBottom="@dimen/pixel_shadow_offset_sm"
            android:text="@string/statement_change_filter"
            android:textColor="@color/pixel_black"
            android:textSize="@dimen/text_pixel_sm"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_state_error"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/state_box_padding"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/state_icon_box_size"
            android:layout_height="@dimen/state_icon_box_size"
            android:background="@drawable/bg_icon_box_red">

            <ImageView
                android:layout_width="@dimen/state_icon_size"
                android:layout_height="@dimen/state_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alert_triangle"
                app:tint="@color/pixel_red" />
        </FrameLayout>

        <TextView
            style="@style/PixelText.Md"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/statement_error_title" />

        <TextView
            android:id="@+id/error_desc"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/statement_error_desc" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            style="@style/PixelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/selector_btn_primary"
            android:minHeight="@dimen/field_height"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingEnd="@dimen/pixel_shadow_offset_sm"
            android:paddingBottom="@dimen/pixel_shadow_offset_sm"
            android:text="@string/statement_retry"
            android:textColor="@color/pixel_black"
            android:textSize="@dimen/text_pixel_sm"
            app:icon="@drawable/ic_rotate_ccw"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_sm"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="@color/pixel_black"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

</LinearLayout>
