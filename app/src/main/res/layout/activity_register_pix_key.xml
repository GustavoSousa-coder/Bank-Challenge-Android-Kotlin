<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastrar_chave_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="@string/cadastrar_chave_subtitulo"
            android:textSize="15sp"
            android:textColor="@color/gray_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/tipo_chave_pix"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <RadioGroup
            android:id="@+id/radioGroupTipoChaveCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/tipoCpf"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:checked="true"
                    android:background="@drawable/bg_chip_pix"
                    android:textColor="@color/text_chip_pix"
                    android:text="@string/chave_cpf"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

                <RadioButton
                    android:id="@+id/tipoCnpj"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pix"
                    android:textColor="@color/text_chip_pix"
                    android:text="@string/chave_cnpj"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

                <RadioButton
                    android:id="@+id/tipoTelefone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pix"
                    android:textColor="@color/text_chip_pix"
                    android:text="@string/chave_telefone"
                    android:textSize="12sp"
                    android:textAllCaps="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/tipoEmail"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pix"
                    android:textColor="@color/text_chip_pix"
                    android:text="@string/chave_email"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

                <RadioButton
                    android:id="@+id/tipoAleatoria"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pix"
                    android:textColor="@color/text_chip_pix"
                    android:text="@string/chave_aleatoria"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

            </LinearLayout>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/valor_da_chave"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black_pure" />

        <EditText
            android:id="@+id/editValorChave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/valor_da_chave_hint"
            android:inputType="text"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="15sp"
            android:textColorHint="@color/gray_secondary" />

        <Button
            android:id="@+id/btnCadastrarChave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/cadastrar_chave"
            android:background="@drawable/bg_button_primary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>